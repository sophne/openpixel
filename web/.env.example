# Copy to .env.local for development, or set these in Coolify. None of them are required.

# Public address of the site (used for links and social previews).
NEXT_PUBLIC_SITE_URL=https://openpixel.example

# The X profile linked in the header and footer.
NEXT_PUBLIC_X_URL=https://x.com/eminvkc

# Set to true once the Mac releases are signed with a Developer ID and notarized by Apple. While false, the site
# explains how to open the Mac app the first time (System Settings → Privacy & Security → Open Anyway) and says its
# Update button leads to the downloads page; once true, it says the Mac app updates itself.
NEXT_PUBLIC_NOTARIZED=false

# PostHog web analytics and session replay (src/lib/consent.ts). Without a token, or with "off", the site has no
# analytics and no cookie banner. The token is the project's public token (Project settings → Project token).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# The project's ingestion host: https://eu.i.posthog.com for the EU cloud.
NEXT_PUBLIC_POSTHOG_HOST=

# GitHub repository the downloads and changelog come from. The downloads are the files with fixed names on its
# newest release: OpenPixel.dmg, OpenPixel-Setup.exe, OpenPixel.AppImage and openpixel.deb (src/lib/platforms.ts).
GITHUB_REPO=sophne/openpixel

# Optional: a fine-grained GitHub token with no permissions (public repositories only), to raise the
# API rate limit. Set it in Coolify as a secret; never commit it.
GITHUB_TOKEN=
