<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime must allow for Electron (Developer ID builds; see electron-builder.yml). Chromium's
     JavaScript engine writes and runs machine code (JIT). Everything inside the app is signed by the same team,
     so library validation stays on. Nothing else: no camera, microphone, location or Apple Events. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
