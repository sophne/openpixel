{
  "name": "openpixel-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "OpenPixel's desktop app: Electron shell, React + Vite editor, Rust core.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:core": "node scripts/build-core.mjs",
    "build:mcp": "cargo build --release --manifest-path ../core/Cargo.toml --bin openpixel",
    "build:electron": "node scripts/build-electron.mjs",
    "build:ui": "vite build",
    "build": "npm run build:electron && npm run build:ui",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "node scripts/check-names.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "start": "electron .",
    "test": "node host/test/run.mjs",
    "test:shell": "node tests/shell-smoke.mjs",
    "test:ui": "node tests/run-ui-test.mjs",
    "test:web": "node tests/web-preview.mjs",
    "compare:shots": "node tests/compare-shots.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build:core && npm run build:mcp && npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "pixelmatch": "^8.0.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
